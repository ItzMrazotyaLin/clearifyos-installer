<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ClearifyOS_Installer.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="О программе"
    CloseButtonText="Закрыть"
    DefaultButton="Close"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            VerticalAlignment="Center">
            <Image
                Width="100"
                Height="100"
                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            Margin="20,0,0,0"
            VerticalAlignment="Center"
            Spacing="6">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="ClearifyOS Installer" />
            <TextBlock
                FontSize="12"
                Opacity="0.6"
                Text="Dev Build 0.0.1" />
            <TextBlock
                FontSize="13"
                Opacity="0.8"
                Text="Made by itzmr" />
            <HyperlinkButton
                Padding="0"
                Content="GitHub репозиторий установщика" 
                NavigateUri="https://github.com/ItzMrazotyaLin/clearifyos-installer" />
        </StackPanel>
    </Grid>
</ContentDialog>
